{
  "name": "ronaldo-vs-messi-live-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze:models": "node scripts/analyze-glb.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "preview": "vite preview",
    "check:live": "node scripts/live-preflight.mjs",
    "test:soak": "node --import tsx scripts/soak-live.mjs"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "latest",
    "tiktok-live-connector": "2.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.6",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
