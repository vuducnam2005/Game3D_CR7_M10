# Server only. Never use a VITE_ prefix for secrets.
GAME_PORT=3001
GAME_SNAPSHOT_PATH=data/game-state.json
# Docker Compose publishes only to the server's loopback interface. Use an SSH tunnel.
DEPLOY_PORT=8080
# Starting frontend port; dev chooses the next free port and prints its URL.
WEB_PORT=5173

# Restart npm run dev after changing this file, then click Connect in /control.
# Defaults to Mock. A public username is enough to attempt a read-only connection.
TIKTOK_ENABLED=false
TIKTOK_USERNAME=
# Optional Euler Stream signing key. No cookies or authenticated sessions are used.
TIKTOK_SIGN_API_KEY=
TIKTOK_CONNECT_TIMEOUT_MS=30000
TIKTOK_RETRY_BASE_MS=2000
TIKTOK_RETRY_MAX_MS=60000
TIKTOK_MAX_RETRIES=5
